{
  "id": "us.priet.drtagger",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],
  "command": "drtagger",
  "separate-locales": false,
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--talk-name=org.freedesktop.secrets",
    "--filesystem=home",
    "--filesystem=/media",
    "--filesystem=/mnt",
    "--filesystem=/run/media"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin"
  },
  "cleanup": [
    "/include",
    "/lib/pkgconfig",
    "/share/man",
    "*.a"
  ],
  "modules": [
    {
      "name": "ffmpeg",
      "buildsystem": "simple",
      "build-commands": [
        "./configure --prefix=/app/libexec/drtagger-ffmpeg --disable-everything --disable-programs --enable-ffmpeg --enable-ffprobe --disable-doc --disable-debug --disable-network --disable-autodetect --disable-shared --enable-static --enable-pic --disable-avdevice --disable-gpl --disable-nonfree --disable-version3 --enable-swresample --enable-avfilter --enable-protocol=file,pipe --enable-demuxer=ape,wv,tta,flac,wav,aiff,mov,dsf,iff,pcm_s16le,pcm_s24le,pcm_s32le,pcm_f32le --enable-decoder=ape,wavpack,tta,alac,flac,pcm_s16le,pcm_s16be,pcm_s24le,pcm_s24be,pcm_s32le,pcm_s32be,pcm_u8,pcm_s8,pcm_f32le,pcm_f32be,pcm_f64le,dsd_lsbf,dsd_msbf,dsd_lsbf_planar,dsd_msbf_planar,dst --enable-encoder=flac,pcm_s16le,pcm_s24le,pcm_s32le,pcm_f32le --enable-muxer=flac,wav,pcm_s16le,pcm_s24le,pcm_s32le,pcm_f32le,null,md5,hash,framemd5 --enable-filter=aresample,aformat,anull,atrim,asetnsamples,ebur128,replaygain,volumedetect,astats --disable-x86asm",
        "make -j$FLATPAK_BUILDER_N_JOBS",
        "install -Dm755 ffmpeg ffprobe -t /app/bin",
        "! /app/bin/ffmpeg -version | grep -q -- --enable-gpl",
        "install -Dm644 LICENSE.md COPYING.LGPLv2.1 -t /app/share/licenses/us.priet.drtagger/ffmpeg"
      ],
      "cleanup": [
        "/libexec"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://ffmpeg.org/releases/ffmpeg-8.0.tar.xz",
          "sha256": "b2751fccb6cc4c77708113cd78b561059b6fa904b24162fa0be2d60273d27b8e"
        }
      ]
    },
    {
      "name": "drtagger",
      "buildsystem": "simple",
      "build-options": {
        "env": {
          "CARGO_HOME": "/run/build/drtagger/cargo",
          "ORT_LIB_LOCATION": "/run/build/drtagger/onnxruntime",
          "CARGO_NET_OFFLINE": "true",
          "RUST_ICU_MAJOR_VERSION_NUMBER": "77"
        }
      },
      "build-commands": [
        "mkdir -p onnxruntime && xz -dc --format=raw --lzma2=dict=64MiB onnxruntime.tar.lzma2 | tar -x -C onnxruntime",
        "cargo --offline build --release --locked -p drtagger -p drtagger-cli",
        "install -Dm755 target/release/drtagger target/release/drtagger-cli -t /app/bin",
        "install -Dm644 data/us.priet.drtagger.gschema.xml -t /app/share/glib-2.0/schemas",
        "glib-compile-schemas /app/share/glib-2.0/schemas",
        "install -Dm644 data/us.priet.drtagger.desktop -t /app/share/applications",
        "install -Dm644 data/us.priet.drtagger.metainfo.xml -t /app/share/metainfo",
        "for s in 128 256 512; do install -Dm644 data/icons/hicolor/${s}x${s}/apps/us.priet.drtagger.png -t /app/share/icons/hicolor/${s}x${s}/apps; done",
        "for mo in target/release/build/drtagger-*/out/locale/*/LC_MESSAGES/drtagger.mo; do lang=$(basename $(dirname $(dirname $mo))); install -Dm644 $mo /app/share/locale/$lang/LC_MESSAGES/drtagger.mo; done",
        "mkdir -p /app/share/drtagger && cp -r models /app/share/drtagger/models",
        "install -Dm644 LICENSE THIRD_PARTY_NOTICES.md -t /app/share/licenses/us.priet.drtagger && install -Dm644 crates/dstkit/LICENSE /app/share/licenses/us.priet.drtagger/dstkit/LICENSE && install -Dm644 crates/chromaprintkit/vendor/chromaprint-1.5.1/LICENSE.md /app/share/licenses/us.priet.drtagger/chromaprint/LICENSE.md && install -Dm644 crates/chromaprintkit/vendor/chromaprint-1.5.1/kissfft/COPYING /app/share/licenses/us.priet.drtagger/kissfft/COPYING",
        "python3 scripts/crate-licenses.py cargo/vendor > /app/share/licenses/us.priet.drtagger/CRATE-LICENSES.txt"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "..",
          "skip": [
            "target",
            ".git",
            ".flatpak-builder",
            "flatpak-build",
            "flatpak-repo",
            "models",
            "Vendor/ffmpeg/ffmpeg",
            "Vendor/ffmpeg/ffprobe",
            ".build",
            "parity/local",
            "parity/MacDump/.build",
            "parity/MacDump/.build-patched"
          ]
        },
        "cargo-sources.json",
        {
          "type": "file",
          "only-arches": [
            "aarch64"
          ],
          "url": "https://cdn.pyke.io/0/pyke:ort-rs/ms@1.31.0/aarch64-unknown-linux-gnu.tar.lzma2",
          "sha256": "380c1b63eedf5671e7b39e4aa0f6c377ecc351c3a7b01ae708a707e73fb54709",
          "dest-filename": "onnxruntime.tar.lzma2"
        },
        {
          "type": "file",
          "only-arches": [
            "x86_64"
          ],
          "url": "https://cdn.pyke.io/0/pyke:ort-rs/ms@1.31.0/x86_64-unknown-linux-gnu.tar.lzma2",
          "sha256": "02aac0d3b4927026292088986d7a377c657c88761b1c068be217a67b35447678",
          "dest-filename": "onnxruntime.tar.lzma2"
        },
        {
          "type": "file",
          "url": "https://huggingface.co/PaddlePaddle/PP-OCRv5_mobile_det_onnx/resolve/e6f4fa85f00e168c862bc462aebca69eef9b3d3d/inference.onnx",
          "sha256": "a431985659dc921974177a95adcfbb90fd9e51989a5e04d70d0b75f597b6e61d",
          "dest": "models/ocr",
          "dest-filename": "det.onnx"
        },
        {
          "type": "file",
          "url": "https://huggingface.co/PaddlePaddle/PP-OCRv5_mobile_det_onnx/resolve/e6f4fa85f00e168c862bc462aebca69eef9b3d3d/inference.yml",
          "sha256": "98069072e1b6b37d727fd9d9f11725faa46d6ea0de012f2ed26caea011c37699",
          "dest": "models/ocr",
          "dest-filename": "det.yml"
        },
        {
          "type": "file",
          "url": "https://huggingface.co/PaddlePaddle/PP-OCRv5_mobile_rec_onnx/resolve/ed152b8b495f84de93cda5709d768548a9127622/inference.onnx",
          "sha256": "da72dc72ca4dc220df0dfde68c1dedc31c58d3e76a25871122e5056227d50092",
          "dest": "models/ocr",
          "dest-filename": "rec.onnx"
        },
        {
          "type": "file",
          "url": "https://huggingface.co/PaddlePaddle/PP-OCRv5_mobile_rec_onnx/resolve/ed152b8b495f84de93cda5709d768548a9127622/inference.yml",
          "sha256": "5dfeb2777f6d0db8177d8128a8acfcf6e6276dc4ac73ea3bf0dc06d6a5e85d8e",
          "dest": "models/ocr",
          "dest-filename": "rec.yml"
        },
        {
          "type": "file",
          "url": "https://huggingface.co/onnx-community/dinov2-small/resolve/8b1f705a3a7f6f062f6bdd21986c1583d3ef105d/onnx/model.onnx",
          "sha256": "f22797eabf810a75e41de68d378541ebea372122b25c4ce3ef25ff618250c20a",
          "dest": "models/cover",
          "dest-filename": "dinov2-small.onnx"
        }
      ]
    }
  ]
}
